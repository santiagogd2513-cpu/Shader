<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_6sdp" />
            <gradient android:angle="0"
                android:startColor="@color/blue_cyan"
                android:endColor="@color/blue_azure" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_6sdp" />
            <solid android:color="@color/blue_indigo" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_6sdp" />
            <solid android:color="#0B2A52" />
            <stroke android:width="1dp" android:color="@color/blue_steel" />
        </shape>
    </item>
</selector>
