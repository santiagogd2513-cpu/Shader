<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed / disabled state: darker blues -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_6sdp" />
            <gradient
                android:angle="0"
                android:startColor="@color/blue_steel"
                android:centerColor="@color/blue_royal"
                android:endColor="@color/blue_midnight" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/blue_normal" />
        </shape>
    </item>
</layer-list>
